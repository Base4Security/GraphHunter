{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Graph Hunter",
  "version": "1.0.0",
  "identifier": "com.graphhunter.app",
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis", "dmg", "app"],
    "publisher": "GraphHunter Contributors",
    "category": "DeveloperTool",
    "shortDescription": "Threat hunting on temporal graphs",
    "longDescription": "GraphHunter es una plataforma de threat hunting sobre grafos temporales con DSL declarativa, ingestion adaptiva multi-fuente, y motor GNN de scoring.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/models/*"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Graph-based threat hunting engine",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; style-src 'self' 'unsafe-inline'; img-src 'self' data: tauri: asset:; script-src 'self'; connect-src 'self' tauri: ipc: http://ipc.localhost http://localhost:3001 ws://localhost:3001"
    }
  }
}
