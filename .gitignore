# Environment
.venv/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Gateway uploaded files
gateway/uploads/

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls

# demo_data holds the small fixtures the test suite reads, and they must
# be committable. Order matters here: the negation has to come AFTER the
# LaTeX block, because `*.log` above was silently swallowing `.log` test
# inputs — `git add demo_data/whatever.log` did nothing, the file stayed
# on one machine, and the test failed everywhere else with no clue why.
!demo_data/**
# ...except the multi-GB corpora, which are downloaded rather than
# committed. Re-ignored after the negation, or it would un-ignore them.
# See demo_data/README.md for what to fetch and where each test uses it.
demo_data/mordor_combined_attacks.json
demo_data/mega_attack_dataset.json
demo_data/mega_dataset_1gb.json

# Other artifacts
**/target/
# Stray per-crate build dirs from custom CARGO_TARGET_DIR runs (e.g. target-alt,
# target-tauri-check, target-test-live-tail) — never commit these.
**/target-*/
**/node_modules/
apps/tauri/dist/
app/dist/
docs/_build/
**/.claude/
.vscode/*
dev-*

# Local exploratory work — not part of the shipped product
spikes/

# Confidential incident reports — keep out of VCS
CSIRT-Report-*.md
docs/_archive/incidents/*.md
!docs/_archive/incidents/.gitkeep

# Personal LaTeX/PDF documentation trees — kept locally (2026-05-07).
# The 5 books (algoritmos/arquitectura/especificacion/manual/paper) were archived
# under docs/_archive/2026-libros-pre-unificacion/ in M0 (2026-05-20), where they
# ARE tracked. Other personal trees remain local-only.
docs/diseno/
docs/formalization/
docs/internals-systems/

