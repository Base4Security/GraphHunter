docs/**/*.aux
docs/**/*.log
docs/**/*.out
docs/**/*.toc
docs/**/*.lof
docs/**/*.lot
docs/**/*.idx
docs/**/*.ilg
docs/**/*.ind
docs/**/*.bbl
docs/**/*.bcf
docs/**/*.blg
docs/**/*.run.xml
docs/**/*.synctex.gz
docs/**/*.fdb_latexmk
docs/**/*.fls
docs/**/*.pdf
!docs/_archive/2026-libros-pre-unificacion/**/*.pdf
docs/**/out.txt
.playwright-mcp/

# Tauri sidecar runtime binaries � downloaded via tools/fetch-sidecar-binaries.sh per release
apps/tauri/src-tauri/binaries/

# Sidecar .NET build artifacts (source lives on feature branches; bin/obj are local)
sidecar/dotnet/**/bin/
sidecar/dotnet/**/obj/

audit-tmp/

# TypeScript / Vite / npm build outputs (untracked post-book-v1.0.0)
dist/
*.tsbuildinfo

# GeoLite2 databases: ~70MB of third-party data under the MaxMind EULA.
# Obtain per apps/tauri/src-tauri/resources/geoip/README.md; never committed.
*.mmdb

# DARPA TC training corpora + local training venv (multi-GB, never committed)
training/.venv/
training/data/**/*.tar.gz
training/data/**/*.json
# DARPA ships the big tables split as numbered continuations —
# ta1-cadets-e3-official-1.json.1, .json.2, ... — which `*.json` does not
# match. Seven of those files are 24 GB and were sitting untracked, one
# `git add -A` away from the index.
training/data/**/*.json.*
training/data/**/*.txt
training/data/**/parsed/
training/data/**/features/

# Scratch probes written by audit subagents into test dirs — never committed.
**/tests/zz_tmp_*.rs
