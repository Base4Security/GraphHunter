{
  "name": "@graphhunter/mcp",
  "version": "2.0.0",
  "description": "MCP server exposing GraphHunter tools (namespaced catalog). Ships as a self-contained bundle with graph-hunter-server: npm run pack.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "graph-hunter-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsc && node dist/src/index.js",
    "test:contract": "node --test dist/tests/contract/*.test.js",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
